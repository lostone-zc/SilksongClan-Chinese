{
  "$schema": "https://raw.githubusercontent.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/main/schemas/base.json",
  "cards": [
    {
      "id": "SpawnGreenPrince",
      "names": {
        "english": "Green Prince",
        "chinese": "翠绿王子",
        "french": "Green Prince"
      },
      "card_art": "@GreenPrinceCardArt",
      "cost": 2,
      "card_type": "monster",
      "rarity": "rare",
      "class": "@Silksong",
      "unlock_level": 6,
      "pools": [
        "MegaPool",
        "UnitsAllBanner"
      ],
      "targets_room": true,
      "effects": [
        {
          "id": "@SpawnGreenPrinceEffect"
        }
      ],
      "lore_tooltips": [
        {
          "english": "The myth we made... by grace... by blade... All bowed before we princes green...",
          "chinese": "我们以圣恩缔造神话...我们以剑刃铸就传奇...<br>众生曾皆对翠绿双王俯首称臣..."
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "GreenPrince",
      "names": {
        "english": "Green Prince",
        "chinese": "翠绿王子",
        "french": "Green Prince"
      },
      "character_art": "@GreenPrinceCharacterArt",
      "size": 3,
      "health": 40,
      "attack_damage": 50,
      "subtypes": ["@Bug", "SubtypesData_BannerUnit"],
      "starting_status_effects": [
        {
          "status": "@Warrior",
          "count": 1
        },
        {
          "status": "@PinMastery",
          "count": 1
        }
      ],
      "triggers": [
        {
          "id": "@GreenPrinceSilksongTrigger"
        }
      ]
    }
  ],
  "upgrades": [
    {
      "id": "GreenPrinceCopyUpgrade",
      "status_effect_upgrades": [
        {
          "status": "fragile",
          "count": 1
        }
      ],
      "trait_upgrades": [
        "@GreenPrinceEphemeral"
      ]
    }
  ],
  "traits": [
    {
      "id": "GreenPrinceEphemeral",
      "name": "CardTraitEphemeral"
    }
  ],
  "character_triggers": [
    {
      "id": "GreenPrinceSilksongTrigger",
      "descriptions": {
        "english": "Add a [ephemeral] Copy with [fragile] to your hand.",
        "chinese": "将这个单位带有[ephemeral]的复制品加入你的手牌，并使其获得[fragile]。"
      },
      "trigger": "@Silksong",
      "effects": [
        {
          "id": "@GreenPrinceCreateCopyEffect"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnGreenPrinceEffect",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@GreenPrince"
    },
    {
      "id": "GreenPrinceCreateCopyEffect",
      "name": "CardEffectAddUnitCard",
      "param_int": 3,
      "param_upgrade": "@GreenPrinceCopyUpgrade",
      "copy_modifiers_from_source": true
    }
  ],
  "sprites": [
    {
      "id": "GreenPrinceCardArt",
      "path": "textures/GreenPrinceCardArt.png"
    },
    {
      "id": "GreenPrinceCharacterArt",
      "path": "textures/GreenPrinceCharacterArt.png"
    }
  ],
  "game_objects": [
    {
      "id": "GreenPrinceCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@GreenPrinceCardArt"
        }
      }
    },
    {
      "id": "GreenPrinceCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@GreenPrinceCharacterArt",
          "transform": {
            "position": {
              "x": 0,
              "y": 1.5,
              "z": 0
            },
            "scale": {
              "x": 1,
              "y": 1,
              "z": 1
            }
          }
        }
      }
    }
  ]
}
